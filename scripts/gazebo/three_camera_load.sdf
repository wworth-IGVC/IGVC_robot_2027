<?xml version="1.0" ?>
<!--
  The load test for acceptance criterion 6: "The Gazebo path runs at usable
  frame rate on a 12 GB laptop GPU, which is the whole point."

  Three rgbd_camera sensors standing in for the three ZED X units, at the poses
  from the URDF in section 3.3 of RESEARCH_QUESTIONS_AND_UNRESOLVED.md, plus
  the RPLiDAR C1 as a gpu_lidar. rgbd_camera is used rather than plain camera
  because the ZED path the stack consumes is RGB *and* registered depth, and
  depth is the expensive half.

  1280x720 at 30 Hz is HD720, the mode the real cameras are most likely to run.
  If this world holds real-time factor near 1.0 with all four sensors on, the
  Gazebo path is viable for perception work on this machine. If it does not,
  drop resolution or rate here first before concluding the machine is unusable.

  This is a sensor load test, not the competition course. It has no lane lines
  and no obstacles on purpose: it isolates render cost.
-->
<sdf version="1.9">
  <world name="three_camera_load">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Give the depth cameras real geometry to resolve; an empty scene makes
         depth rendering unrealistically cheap. -->
    <model name="clutter_a">
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="clutter_b">
      <pose>3 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="clutter_c">
      <pose>3 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.2 0.3 0.9 1</ambient><diffuse>0.2 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="sensor_rig">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="chassis_link">
        <visual name="visual">
          <geometry><box><size>0.6 0.5 0.3</size></box></geometry>
        </visual>

        <!-- left_zed_camera_x: 0.361 0.18 0.248, rpy 0 10deg 95deg -->
        <sensor name="left_zed" type="rgbd_camera">
          <pose>0.361 0.18 0.248 0 0.1745 1.6581</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>zed_left</topic>
          <camera>
            <horizontal_fov>1.7</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.3</near><far>20</far></clip>
          </camera>
        </sensor>

        <!-- front_zed_camera_x: 0.405 0 0.246, rpy 0 0 0 -->
        <sensor name="front_zed" type="rgbd_camera">
          <pose>0.405 0 0.246 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>zed_front</topic>
          <camera>
            <horizontal_fov>1.7</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.3</near><far>20</far></clip>
          </camera>
        </sensor>

        <!-- right_zed_camera_x: 0.359 -0.195 0.251, rpy 0 10deg -95deg -->
        <sensor name="right_zed" type="rgbd_camera">
          <pose>0.359 -0.195 0.251 0 0.1745 -1.6581</pose>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>zed_right</topic>
          <camera>
            <horizontal_fov>1.7</horizontal_fov>
            <image><width>1280</width><height>720</height></image>
            <clip><near>0.3</near><far>20</far></clip>
          </camera>
        </sensor>

        <!-- top_rplidar_c1: 0.225 0 0.46 -->
        <sensor name="rplidar" type="gpu_lidar">
          <pose>0.225 0 0.46 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
