# =============================================================================
# IGVC 2027 - consolidated x86 development image
#
# ONE image replacing the two we previously needed:
#   ghcr.io/gold-rush-robotics/dev-zed  (private, ROS 2 Jazzy, no public recipe)
#   igvc-humble-fused-drive             (docker/Dockerfile.humble-fused-drive)
#
# Contains:
#   Ubuntu 22.04 (Jammy - required by ROS 2 Humble)
#   CUDA 13.0    (Blackwell / RTX 50-series need >= 12.8)
#   ZED SDK 5.3.0 (same version as the Jetson image)
#   ROS 2 Humble + zed-ros2-wrapper, zed_msgs, zed_description
#   Nav2, ros2_control, robot_localization
#   PyTorch + Ultralytics (CUDA 13 wheels)
#
# Why Humble and not Jazzy: everything on the robot side of the org
# (jetson-zed, jetson-ros-base, jetson-isaac-ros, isaac-ros) is already
# Humble. The private dev-zed image was the lone Jazzy holdout in the robot
# path. Building this on Humble finishes that consolidation and removes the
# dependency on an image nobody outside the org can pull.
#
# Build (takes a while - the ZED SDK installer alone is 1.6 GB):
#   docker build -f docker/Dockerfile.igvc-zed-humble -t igvc-zed-humble:latest .
#
# The BASE_IMAGE / ZED_SDK_* / CUDA_MAJOR args exist so the same recipe can
# target a different CUDA level, or an L4T base for the Jetson.
# =============================================================================

ARG BASE_IMAGE=nvidia/cuda:13.0.0-devel-ubuntu22.04
FROM ${BASE_IMAGE}

ARG ROS2_DIST=humble
ARG UBUNTU_MAJOR=22
ARG CUDA_MAJOR=13
# ZED SDK 5.3.0, matching docker_images/jetson-zed so x86 and Jetson run the
# same SDK. Do NOT drop to 5.1.0 (the version in the old dev-zed tag): the
# current zed-ros2-wrapper requires SDK >= 5.2 and fails to compile against
# 5.1.0 with
#   error: 'struct sl::CustomObjectDetectionProperties' has no member
#          named 'object_tracking_parameters'
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=3
ARG ZED_SDK_PATCH=0
ARG DEBIAN_FRONTEND=noninteractive

ENV ROS_DISTRO=${ROS2_DIST}
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility,graphics
ENV TZ=America/Chicago

# -----------------------------------------------------------------------------
# Base system + locale
# -----------------------------------------------------------------------------
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        apt-utils dialog locales software-properties-common \
        curl wget git jq less udev sudo zstd usbutils \
        build-essential cmake \
        python3 python3-dev python3-pip python3-wheel \
        libpng-dev libgomp1 libopencv-dev libpq-dev \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# -----------------------------------------------------------------------------
# ROS 2 Humble
# -----------------------------------------------------------------------------
RUN add-apt-repository universe \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
         -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
         > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-${ROS2_DIST}-ros-base \
        ros-dev-tools \
        python3-colcon-common-extensions \
        python3-rosdep \
    && rosdep init || true \
    && rosdep update --rosdistro ${ROS2_DIST} \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# ZED SDK
#
# The installer is ~1.6 GB. skip_cuda because CUDA already comes from the base
# image; skip_tools because the GUI tools are useless in a headless container.
# The libusb symlink is required - the SDK links against the unversioned name.
# -----------------------------------------------------------------------------
ENV ZED_SDK_URL="https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH}/cu${CUDA_MAJOR}/ubuntu${UBUNTU_MAJOR}"

RUN echo "ZED SDK URL: ${ZED_SDK_URL}" \
    && if [ "$(curl -L -I "${ZED_SDK_URL}" -o /dev/null -s -w '%{http_code}')" != "200" ]; then \
         echo "ERROR: ZED SDK installer not found at ${ZED_SDK_URL}"; exit 1; \
       fi \
    && echo "# CUDA Version ${CUDA_MAJOR}" > /usr/local/cuda/version.txt \
    && wget -q -O /tmp/ZED_SDK.run "${ZED_SDK_URL}" \
    && chmod +x /tmp/ZED_SDK.run \
    && /tmp/ZED_SDK.run -- silent skip_tools skip_cuda \
    && ln -sf /lib/x86_64-linux-gnu/libusb-1.0.so.0 /usr/lib/x86_64-linux-gnu/libusb-1.0.so \
    && rm -f /tmp/ZED_SDK.run \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# ZED ROS 2 stack
#
# zed_components depends on zed_msgs (zed-ros2-interfaces) and zed_description
# (zed-ros2-description), so all three are cloned to make the image build
# standalone. Path matches what docker-compose.yml expects:
#   /root/ros2_ws/src/zed-ros2-wrapper/zed_wrapper/config/common_stereo.yaml
# -----------------------------------------------------------------------------
WORKDIR /root/ros2_ws/src

ARG ZED_WRAPPER_REPO=https://github.com/Gold-Rush-Robotics/zed-ros2-wrapper-2025.git
ARG ZED_WRAPPER_BRANCH=master

RUN git clone --depth 1 -b ${ZED_WRAPPER_BRANCH} ${ZED_WRAPPER_REPO} zed-ros2-wrapper \
    && git clone --depth 1 https://github.com/stereolabs/zed-ros2-interfaces.git zed-ros2-interfaces \
    && git clone --depth 1 https://github.com/stereolabs/zed-ros2-description.git zed-ros2-description

WORKDIR /root/ros2_ws

RUN apt-get update \
    && rosdep update --rosdistro ${ROS2_DIST} \
    && rosdep install --from-paths src --ignore-src -r -y --rosdistro ${ROS2_DIST} \
    && rm -rf /var/lib/apt/lists/*

RUN /bin/bash -c "source /opt/ros/${ROS2_DIST}/setup.bash \
    && colcon build --symlink-install \
         --parallel-workers $(nproc) \
         --base-paths src \
         --cmake-args ' -DCMAKE_BUILD_TYPE=Release' \
                      ' -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs' \
                      ' -DCMAKE_CXX_FLAGS=\"-Wl,--allow-shlib-undefined\"'"

# -----------------------------------------------------------------------------
# IGVC workspace dependencies
#
# Same set as docker/Dockerfile.humble-fused-drive, including the four that
# were missing there (libasio-dev, diagnostic-updater, sensor-msgs-py,
# python3-pyqt5) - see that file for what each one fixes.
# -----------------------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-${ROS2_DIST}-xacro \
        ros-${ROS2_DIST}-robot-state-publisher \
        ros-${ROS2_DIST}-controller-manager \
        ros-${ROS2_DIST}-ros2-control \
        ros-${ROS2_DIST}-ros2-controllers \
        ros-${ROS2_DIST}-joy \
        ros-${ROS2_DIST}-teleop-twist-joy \
        ros-${ROS2_DIST}-rviz2 \
        ros-${ROS2_DIST}-robot-localization \
        ros-${ROS2_DIST}-navigation2 \
        ros-${ROS2_DIST}-nav2-bringup \
        ros-${ROS2_DIST}-cv-bridge \
        ros-${ROS2_DIST}-image-geometry \
        ros-${ROS2_DIST}-tf2-geometry-msgs \
        ros-${ROS2_DIST}-message-filters \
        ros-${ROS2_DIST}-odom-to-tf-ros2 \
        ros-${ROS2_DIST}-twist-stamper \
        ros-${ROS2_DIST}-simulation-interfaces \
        ros-${ROS2_DIST}-diagnostic-updater \
        ros-${ROS2_DIST}-sensor-msgs-py \
        libasio-dev \
        python3-pyqt5 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python / ML stack
# -----------------------------------------------------------------------------
RUN pip3 install --no-cache-dir -U pip \
    && pip3 install --no-cache-dir 'numpy<2' ultralytics opencv-python-headless torch \
    && pip3 uninstall -y opencv-python || true

# setuptools LAST - torch/ultralytics drag it past 80, which breaks
# colcon-core 0.21.1 and every ament_python package.
RUN pip3 install --no-cache-dir 'setuptools==58.2.0' 'packaging<25'

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -e' \
    'source /opt/ros/'"${ROS2_DIST}"'/setup.bash' \
    'if [ -f /root/ros2_ws/install/setup.bash ]; then' \
    '  source /root/ros2_ws/install/setup.bash' \
    'fi' \
    'exec "$@"' \
    > /sbin/ros_entrypoint.sh \
    && chmod 755 /sbin/ros_entrypoint.sh

WORKDIR /root/ros2_ws

ENTRYPOINT ["/sbin/ros_entrypoint.sh"]
CMD ["bash"]
