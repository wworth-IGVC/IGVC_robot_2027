# RViz view for the Gazebo simulation.
#
# Separate from config.rviz on purpose. That one is fixed to base_link and
# shows only the robot model and TF, which is right for inspecting the robot
# but wrong for watching it drive: the robot stays put and the world slides
# underneath. This one is fixed to odom, so the robot moves through the course.
#
# It also adds the two displays that make the point that this is a real ROS
# robot rather than a rendering: the lidar returns on /scan, and the simulated
# camera on the front ZED's rectified colour topic.
#
# Topic names here are the SECTION 3.7 CONTRACT names, not raw Gazebo names.
# RQ-03 landed 2026-09-15: config/gazebo_bridge.yaml renames /front_zed/image
# to /front_zed_camera_x/zed_node/rgb/color/rect/image on the way out, so this
# file names what the rest of the stack names.
#
# /odom here is the CORRECTED odometry from gazebo_odom_shim, not Gazebo's own.
# Gazebo's raw odometry frame follows the spawn heading; pointing this at
# /sim/odom_body_frame instead would draw the trail 135 degrees off the robot.
#
# CAREFUL: RViz WRITES THIS FILE. With --symlink-install the installed copy is
# a symlink to this one, so saving a view from the GUI - or RViz deciding to
# save on exit - rewrites it in RViz's own serialisation, replacing 0.03 with
# 0.029999999329447746, baking in window geometry, and deleting every comment
# above. That happened on 2026-09-15 and was reverted. If `git diff` on this
# file is suddenly 350 lines, that is what happened; revert and re-apply the
# real change by hand.
#
# NavigatorSearchGrid (/navigator/search_grid, nav_search_grid:=true, the
# default) is the window ahead of the robot the navigator's lane search plans
# over, as it is generated each cycle: purple blocked (paint, barrels, the
# lidar map), cyan passable but dropped (too narrow for the robot, or unknown
# too far from seen ground), blue to red the clearance cost of free cells,
# grey searched unknown. The magenta NavigatorLanePath is chosen over it.
#
# THIS IS THE "DEBUG" VIEW (rviz_view:=debug): every display, for finding out
# why the robot did something. The default since 2026-10-20 is the lighter
# "demo" view, gazebo_demo.rviz, for watching it drive.
#
# Sync and speed, 2026-10-20 (RVIZ_VIEWS_PLAN): the two base_link grids,
# LaneCostmap and NavigatorSearchGrid, have Use Timestamp true, so each is
# drawn at the robot pose of its own stamp, as /lane_path is; with false they
# were drawn at the newest pose and slid against the path. Every perception
# display (maps, path, images, markers, laser scan) has queue Depth 1, so a
# slow RViz draws the newest message instead of working through a backlog of
# stale ones. Frame Rate 30 to 20 and the Odometry trail 200 arrows to 30,
# both to give the simulator back some of the GPU and CPU.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 40; 40
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: FrontCamera
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /front_zed_camera_x/zed_node/rgb/color/rect/image
      Value: true
    - Angle Tolerance: 0.1
      Class: rviz_default_plugins/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 30
      Name: Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Color: 60; 220; 60
        Head Length: 0.12
        Head Radius: 0.06
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: LaneDetectorOverlay
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_debug/cam0/overlay
      Value: true
    - Alpha: 0.6
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: LaneCostmap
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_costmap
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_costmap_updates
      Use Timestamp: true
      Value: true
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: LaneMap
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_map
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_map_updates
      Use Timestamp: false
      Value: false
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: LidarObstacleMap
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_obstacle_map
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_obstacle_map_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.6
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: NavigatorSearchGrid
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigator/search_grid
      Update Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigator/search_grid_updates
      Use Timestamp: true
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 0; 255
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.08
      Name: NavigatorLanePath
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Color: 255; 85; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: YOLOPv2Lanes
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lane_segmentation/lanes
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 2.4
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1500
